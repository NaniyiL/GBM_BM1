Seuobj$CellType_L1 <- dplyr::case_when(
  Seuobj$celltype %in% c("Tumor cell", "Prol.tumor cell") ~ "Tumor",
  Seuobj$celltype == "Endothelial" ~ "Endothelial",
  Seuobj$celltype == "Stromal cell" ~ "Stromal",
  Seuobj$celltype == "Myeloid cell" ~ "Myeloid",
  Seuobj$celltype == "NK/T cell" ~ "T/NK",
  Seuobj$celltype == "Oligodendrocyte" ~ "Glial",
  TRUE ~ "Other"
)

