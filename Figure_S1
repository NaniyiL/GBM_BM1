Glioma_sub <- NormalizeData(Glioma_sub, verbose = FALSE)

Glioma_sub <- FindVariableFeatures(
  Glioma_sub,
  selection.method = "vst",
  nfeatures = 3000,
  verbose = FALSE
)

Glioma_sub <- ScaleData(
  Glioma_sub,
  features = VariableFeatures(Glioma_sub),
  verbose = FALSE
)

Glioma_sub <- RunPCA(
  Glioma_sub,
  features = VariableFeatures(Glioma_sub),
  npcs = 50,
  verbose = FALSE
)

Glioma_sub <- RunHarmony(
  Glioma_sub,
  group.by.vars = "Sample",
  reduction.use = "pca",
  dims.use = 1:30,
  project.dim = FALSE
)
Reductions(Glioma_sub)

Glioma_sub <- RunUMAP(
  Glioma_sub,
  reduction = "harmony",
  dims = 1:30
)

Glioma_sub <- RunTSNE(
  Glioma_sub,
