library(Seurat)

base_dir <- "/home/data/t030736/GBM_BM1"

files <- c(
  BrM1 = file.path(base_dir, "BrM1.rds"),
  GBM1 = file.path(base_dir, "GBM1.rds"),
  GBM_BM_EnSt = file.path(base_dir, "GBM_BM_EnSt.rds")
)

objs <- lapply(names(files), function(n) {
  x <- readRDS(files[[n]])
  x$SourceFile <- n
  print(n)
  print(table(x$CellType_L1, useNA = "ifany"))
  x
})
names(objs) <- names(files)
merge_cells <- function(type) {
  x <- lapply(objs, function(obj) {
    subset(obj, subset = CellType_L1 == type)
  })
  
  names(x) <- names(objs)
  x <- x[vapply(x, ncol, numeric(1)) > 0]
  
  if (length(x) == 0) stop("没有找到细胞类型：", type)
  
  if (length(x) == 1) return(x[[1]])
  
  merge(
    x = x[[1]],
    y = x[-1],
    add.cell.ids = names(x),
    project = type
  )
}

Endothelial <- merge_cells("Endothelial")
Stromal <- merge_cells("Stromal")

