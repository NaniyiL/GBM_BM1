for (nm in names(objs)) {
  x <- objs[[nm]]
  
  if (nm == "BrM1") {
    x$Patient <- ifelse(
      !is.na(x$SampleID) & x$SampleID != "",
      paste0("BrM_", x$SampleID),
      NA
    )
    x$Disease.subtype <- "BrM"
    
  } else if (nm == "GBM1") {
    x$Patient <- ifelse(
      !is.na(x$donor_id) & x$donor_id != "",
      paste0("GBM_", x$donor_id),
      ifelse(
        !is.na(x$orig.ident) & x$orig.ident != "",
        paste0("GBM_", x$orig.ident),
        NA
      )
    )
    x$Disease.subtype <- as.character(x$Disease)
    
  } else {
    x$Patient <- as.character(x$Patient)
    x$Disease.subtype <- as.character(x$Disease.subtype)
  }
  
  objs[[nm]] <- x
}

merge_cells <- function(type) {
  x <- lapply(objs, function(obj) {
    subset(obj, subset = CellType_L1 == type)
  })
  
  names(x) <- names(objs)
  x <- x[vapply(x, ncol, numeric(1)) > 0]
  
  merge(
    x = x[[1]],
    y = x[-1],
    add.cell.ids = names(x),
    project = type
  )
}

